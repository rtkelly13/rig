+"""Licence action entry points. Result codes are data, never the process exit status."""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+from pathlib import Path
+
+from estate_actions.cli import emit
+from estate_actions.data import Invalid, canonical, decode, sequence
+from estate_actions.licence_report import inventory, render
+from estate_actions.licence_scan import (
+    fetch_scanner,
+    load_pin,
+    lockfiles_of,
+    missing_lockfiles,
+    run_scanner,
+    runner_platform,
+)
+from estate_actions.licences import (
+    DEFAULT_POLICY,
+    Evaluation,
+    Policy,
+    evaluate,
+    make_packet,
+    normalise,
+    parse_overrides,
+    verify_packet,
+)
+
+
+def directory() -> Path:
+    base = Path(os.environ.get("REPORT_DIRECTORY") or os.environ.get("RUNNER_TEMP") or "temp")
+    target = base / "estate-actions" / "licences"
+    target.mkdir(parents=True, exist_ok=True)
+    return target
+
+
+def scan() -> int:
+    root = Path(os.environ.get("SCAN_ROOT") or ".").resolve()
+    out = directory()
+    try:
+        pin = load_pin(Path(os.environ["PIN_FILE"]))
+        override = os.environ.get("SCANNER_BINARY", "")
+        binary = Path(override) if override else fetch_scanner(pin, runner_platform(), out)
+        arguments = [str(item) for item in sequence(pin["arguments"])]
+        code, raw = run_scanner(binary, arguments, root, out / "osv-scanner.json")
+        packet = make_packet(
+            normalise(raw, str(root)),
+            lockfiles_of(raw, root),
+            missing_lockfiles(root),
+            {
+                "name": "osv-scanner",
+                "version": str(pin["version"]),
+                "arguments": arguments,
+                "exit_code": code,
+            },
+        )
+    except (Invalid, OSError, KeyError, TimeoutError) as error:
+        message = str(error) if isinstance(error, Invalid) else f"Licence scan failed: {type(error).__name__}"
+        print(f"Licence scan incomplete: {message}")
+        emit({"scan-file": "", "evidence-key": "", "error-code": "2", "issue": message})
+        return 0
+    scan_file = out / "scan.json"
+    scan_file.write_text(canonical(packet) + "\n", encoding="utf-8")
+    emit(
+        {
+            "scan-file": str(scan_file.resolve()),
+            "evidence-key": str(packet["evidence_key"]),
+            "error-code": "0",
+        }
+    )
+    counts = len(sequence(packet["packages"])), len(sequence(packet["lockfiles"]))
+    print(f"Licence scan: {counts[0]} packages from {counts[1]} lockfiles")
+    return 0
+
+
+def optional_json(variable: str, default: str) -> object | None:
+    path = Path(os.environ.get(variable) or default)
+    return decode(path.read_text(encoding="utf-8")) if path.is_file() else None
+
+
+def check() -> int:
+    out = directory()
+    evidence_key = ""
+    issue = ""
+    evaluation = Evaluation()
+    try:
+        scan_file = os.environ.get("SCAN_FILE", "")
+        if not scan_file:
+            raise Invalid(os.environ.get("SCAN_ISSUE") or "No licence scan was supplied")
+        packet = verify_packet(decode(Path(scan_file).read_text(encoding="utf-8")))
+        evidence_key = str(packet["evidence_key"])
+        local = optional_json("POLICY_FILE", ".github/licence-policy.json")
+        policy = Policy.merge(DEFAULT_POLICY, local) if local is not None else Policy.parse(DEFAULT_POLICY)
+        overrides_data = optional_json("OVERRIDES_FILE", ".github/licence-overrides.json")
+        overrides = parse_overrides(overrides_data) if overrides_data is not None else []
+        evaluation = evaluate(packet, policy, overrides)
+    except (Invalid, OSError, KeyError) as error:
+        issue = str(error) if isinstance(error, Invalid) else "Invalid or inaccessible licence input"
+        evaluation = Evaluation(issues=[issue])
+        issue = ""
+    markdown = render(evaluation, evidence_key, issue)
+    markdown_file = out / "report.md"
+    markdown_file.write_text(markdown, encoding="utf-8")
+    inventory_file = out / "inventory.json"
+    inventory_file.write_text(canonical(inventory(evaluation)) + "\n", encoding="utf-8")
+    emit(
+        {
+            "markdown": markdown,
+            "markdown-file": str(markdown_file.resolve()),
+            "inventory-file": str(inventory_file.resolve()),
+            "error-code": str(evaluation.error_code),
+            "decision": evaluation.decision,
+            "evidence-key": evidence_key,
+        }
+    )
+    print(f"Licences: {evaluation.decision}; advisory error code: {evaluation.error_code}")
+    return 0
+
+
+def run(mode: str) -> int:
+    return scan() if mode == "scan" else check()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("mode", choices=("scan", "check"))
+    return run(parser.parse_args().mode)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
