@@ -0,0 +1,124 @@
+"""Deterministic Markdown for a licence evaluation. Sized to fit one sticky comment."""
+
+from __future__ import annotations
+
+from collections import Counter
+
+from estate_actions.licences import ACCEPTED, ALLOW, DENY, EXCLUDED, REVIEW, UNKNOWN, Evaluation, Finding
+from estate_actions.report import safe
+
+TITLE = "## Dependency licences"
+MAX_ROWS = 100  # GitHub comments are limited to 65,536 characters; the inventory file has the rest.
+LABELS = {
+    DENY: "denied",
+    UNKNOWN: "unknown",
+    REVIEW: "needs review",
+    ACCEPTED: "accepted",
+    ALLOW: "allowed",
+    EXCLUDED: "not shipped",
+}
+ORDER = [DENY, UNKNOWN, REVIEW, ACCEPTED, ALLOW, EXCLUDED]
+
+
+def row(finding: Finding) -> str:
+    package = finding.package
+    expression = finding.expression or "(none declared)"
+    marker = " (override)" if finding.overridden else ""
+    sources = ", ".join(sorted({f"`{safe(path)}`" for path in package.sources}))
+    return (
+        f"| {LABELS[finding.status]} | {safe(package.ecosystem)} | {safe(package.name)} "
+        f"| {safe(package.version)} | {safe(expression)}{marker} | {sources} |"
+    )
+
+
+def render(evaluation: Evaluation, evidence_key: str, issue: str = "") -> str:
+    lines = [TITLE, ""]
+    summary = {
+        "COMPLIANT": "Every shipped dependency has an allowed or accepted licence.",
+        "VIOLATION": "Shipped dependencies have denied, unknown or unreviewed licences.",
+        "INCOMPLETE": "The shipped dependency set could not be fully established.",
+    }[evaluation.decision]
+    lines += [f"**{evaluation.decision}**: {summary}", ""]
+    for text in [issue, *evaluation.issues]:
+        if text:
+            lines += [f"- {safe(text)}"]
+    if issue or evaluation.issues:
+        lines.append("")
+
+    counts = Counter(finding.status for finding in evaluation.findings)
+    lines += ["| " + " | ".join(LABELS[s] for s in ORDER) + " |", "|" + " ---: |" * len(ORDER)]
+    lines += ["| " + " | ".join(str(counts[s]) for s in ORDER) + " |", ""]
+
+    problems = sorted(
+        evaluation.violations,
+        key=lambda item: (ORDER.index(item.status), item.package.ecosystem, item.package.name.casefold()),
+    )
+    if problems:
+        lines += [
+            "### Needs action",
+            "",
+            "Fix the dependency, or add a cited entry to `.github/licence-overrides.json`: "
+            "`license` corrects missing or wrong metadata; `accept` records a review decision.",
+            "",
+            "| Status | Ecosystem | Package | Version | Licence | Lockfiles |",
+            "| --- | --- | --- | --- | --- | --- |",
+        ]
+        lines += [row(item) for item in problems[:MAX_ROWS]]
+        if len(problems) > MAX_ROWS:
+            lines.append(f"\n{len(problems) - MAX_ROWS} more in the inventory file.")
+        lines.append("")
+    if evaluation.missing_lockfiles:
+        lines += [
+            "### Manifests without a lockfile",
+            "",
+            "Commit a lockfile (for .NET, set `RestorePackagesWithLockFile`) or exclude the path in "
+            "`.github/licence-policy.json` if it is never published.",
+            "",
+        ]
+        lines += [f"- `{safe(path)}`" for path in evaluation.missing_lockfiles] + [""]
+    accepted = [item for item in evaluation.findings if item.status == ACCEPTED]
+    if accepted:
+        lines += ["<details><summary>Accepted after review</summary>", ""]
+        lines += [
+            f"- {safe(item.package.name)} {safe(item.package.version)}: {safe(item.note)}"
+            for item in accepted
+        ]
+        lines += ["", "</details>", ""]
+    if evaluation.stale_overrides:
+        lines += ["<details><summary>Overrides matching no scanned package (remove them)</summary>", ""]
+        lines += [f"- `{safe(label)}`" for label in evaluation.stale_overrides] + ["", "</details>", ""]
+
+    shipped = Counter(
+        finding.expression or "(none declared)"
+        for finding in evaluation.findings
+        if finding.status in (ALLOW, ACCEPTED)
+    )
+    if shipped:
+        lines += [
+            "<details><summary>Licences shipped</summary>",
+            "",
+            "| Licence | Packages |",
+            "| --- | ---: |",
+        ]
+        lines += [f"| {safe(name)} | {count} |" for name, count in sorted(shipped.items())]
+        lines += ["", "</details>", ""]
+    lines.append(
+        f"<sub>Evidence key `{safe(evidence_key or 'none')}`. Error code {evaluation.error_code}.</sub>"
+    )
+    return "\n".join(lines) + "\n"
+
+
+def inventory(evaluation: Evaluation) -> list[dict[str, object]]:
+    return [
+        {
+            "ecosystem": item.package.ecosystem,
+            "name": item.package.name,
+            "version": item.package.version,
+            "license": item.expression,
+            "status": item.status,
+            "overridden": item.overridden,
+            "note": item.note,
+            "lockfiles": sorted(set(item.package.sources)),
+        }
+        for item in evaluation.findings
+    ]
diff --git a/src/estate_actions/licence_scan.py b/src/estate_actions/licence_scan.py
