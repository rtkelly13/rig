@@ -0,0 +1,470 @@
+"""Deterministic dependency licence evaluation. Pure functions: no network, no subprocesses.
+
+The scan phase (``licence_scan``) freezes what the scanner reported into a fingerprinted packet.
+This module judges that packet against a policy and the consuming repository's overrides.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from dataclasses import dataclass, field
+from fnmatch import fnmatchcase
+
+from estate_actions.data import Invalid, canonical, integer, mapping, sequence, string
+
+SCHEMA_VERSION = 1
+
+# Statuses ordered by severity. An OR expression takes its least severe option, AND its most severe.
+ALLOW, REVIEW, UNKNOWN, DENY = "allow", "review", "unknown", "deny"
+SEVERITY = {ALLOW: 0, REVIEW: 1, UNKNOWN: 2, DENY: 3}
+ACCEPTED, EXCLUDED = "accepted", "excluded"
+
+# Placeholders the scanner or registry metadata use for "no usable licence".
+UNUSABLE = {"", "unknown", "non-standard", "noassertion", "none"}
+
+DEFAULT_POLICY: dict[str, object] = {
+    "schema_version": SCHEMA_VERSION,
+    # Suitable for packages published under a permissive licence (MIT, Apache-2.0, BSD).
+    "allow": [
+        "0BSD",
+        "Apache-2.0",
+        "BlueOak-1.0.0",
+        "BSD-2-Clause",
+        "BSD-3-Clause",
+        "BSL-1.0",
+        "CC-BY-3.0",
+        "CC-BY-4.0",
+        "CC0-1.0",
+        "ISC",
+        "MIT",
+        "MIT-0",
+        "PSF-2.0",
+        "Python-2.0",
+        "Unicode-3.0",
+        "Unicode-DFS-2016",
+        "Unlicense",
+        "X11",
+        "Zlib",
+    ],
+    # Weak copyleft: usually fine to depend on unmodified, but someone must say so.
+    "review": [
+        "CDDL-1.0",
+        "CDDL-1.1",
+        "EPL-1.0",
+        "EPL-2.0",
+        "LGPL-2.0-only",
+        "LGPL-2.0-or-later",
+        "LGPL-2.1-only",
+        "LGPL-2.1-or-later",
+        "LGPL-3.0-only",
+        "LGPL-3.0-or-later",
+        "MPL-1.1",
+        "MPL-2.0",
+    ],
+    "deny": [
+        "AGPL-1.0-only",
+        "AGPL-1.0-or-later",
+        "AGPL-3.0-only",
+        "AGPL-3.0-or-later",
+        "BUSL-1.1",
+        "CC-BY-NC-4.0",
+        "CC-BY-NC-SA-4.0",
+        "Elastic-2.0",
+        "GPL-1.0-only",
+        "GPL-1.0-or-later",
+        "GPL-2.0-only",
+        "GPL-2.0-or-later",
+        "GPL-3.0-only",
+        "GPL-3.0-or-later",
+        "SSPL-1.0",
+    ],
+    # Dependency groups the scanner reports that never ship with a published package.
+    "dev_groups": ["dev"],
+    # Lockfiles (and manifests) of projects that are never published: tests, benchmarks, tools.
+    "exclude_paths": [],
+}
+
+
+@dataclass(frozen=True)
+class Policy:
+    allow: frozenset[str]
+    review: frozenset[str]
+    deny: frozenset[str]
+    dev_groups: frozenset[str]
+    exclude_paths: tuple[str, ...]
+
+    @staticmethod
+    def parse(value: object) -> Policy:
+        data = mapping(value)
+        if integer(data.get("schema_version")) != SCHEMA_VERSION:
+            raise Invalid(f"Licence policy schema_version must be {SCHEMA_VERSION}")
+        unknown = set(data) - set(DEFAULT_POLICY)
+        if unknown:
+            raise Invalid(f"Unknown licence policy keys: {', '.join(sorted(unknown))}")
+
+        def ids(key: str) -> frozenset[str]:
+            return frozenset(string(item).casefold() for item in sequence(data.get(key, [])))
+
+        allow, review, deny = ids("allow"), ids("review"), ids("deny")
+        overlap = (allow & review) | (allow & deny) | (review & deny)
+        if overlap:
+            raise Invalid(f"Licences listed in more than one class: {', '.join(sorted(overlap))}")
+        return Policy(
+            allow,
+            review,
+            deny,
+            ids("dev_groups"),
+            tuple(string(item) for item in sequence(data.get("exclude_paths", []))),
+        )
+
+    @staticmethod
+    def merge(base: dict[str, object], local: object) -> Policy:
+        """Overlay a repository's policy keys on the bundled default, key by key."""
+        merged = dict(base)
+        merged.update(mapping(local))
+        return Policy.parse(merged)
+
+    def excluded(self, path: str) -> bool:
+        return any(fnmatchcase(path, pattern) for pattern in self.exclude_paths)
+
+    def classify_id(self, licence: str) -> str:
+        key = licence.casefold()
+        if key in self.deny:
+            return DENY
+        if key in self.review:
+            return REVIEW
+        if key in self.allow:
+            return ALLOW
+        return UNKNOWN
+
+
+# --- SPDX expressions ------------------------------------------------------------------------
+
+TOKEN = re.compile(r"\s*(\(|\)|[A-Za-z0-9.+:-]+)")
+
+
+def tokens(expression: str) -> list[str]:
+    result: list[str] = []
+    position = 0
+    text = expression.strip()
+    while position < len(text):
+        match = TOKEN.match(text, position)
+        if not match:
+            raise Invalid(f"Cannot parse SPDX expression: {expression}")
+        result.append(match.group(1))
+        position = match.end()
+    return result
+
+
+def classify(expression: str, policy: Policy) -> str:
+    """Classify an SPDX licence expression. Anything unparseable or unlisted is UNKNOWN."""
+    if expression.strip().casefold() in UNUSABLE:
+        return UNKNOWN
+    try:
+        items = tokens(expression)
+    except Invalid:
+        return UNKNOWN
+    position = 0
+
+    def peek() -> str:
+        return items[position].upper() if position < len(items) else ""
+
+    def take() -> str:
+        nonlocal position
+        if position >= len(items):
+            raise Invalid("Unexpected end of SPDX expression")
+        position += 1
+        return items[position - 1]
+
+    def disjunction() -> str:
+        status = conjunction()
+        while peek() == "OR":
+            take()
+            other = conjunction()
+            status = min(status, other, key=SEVERITY.__getitem__)
+        return status
+
+    def conjunction() -> str:
+        status = term()
+        while peek() == "AND":
+            take()
+            other = term()
+            status = max(status, other, key=SEVERITY.__getitem__)
+        return status
+
+    def term() -> str:
+        token = take()
+        if token == "(":
+            status = disjunction()
+            if take() != ")":
+                raise Invalid("Unbalanced SPDX expression")
+            return status
+        if token.upper() in {"AND", "OR", "WITH", ")"}:
+            raise Invalid("Misplaced SPDX operator")
+        if peek() == "WITH":
+            take()
+            exception = take()
+            # A policy may list the exact combination; otherwise the base licence decides.
+            combined = policy.classify_id(f"{token} WITH {exception}")
+            return combined if combined != UNKNOWN else policy.classify_id(token)
+        return policy.classify_id(token)
+
+    try:
+        status = disjunction()
+    except Invalid:
+        return UNKNOWN
+    return status if position == len(items) else UNKNOWN
+
+
+# --- Scan packets ------------------------------------------------------------------------------
+
+
+def package_key(ecosystem: str, name: str) -> tuple[str, str]:
+    eco = ecosystem.casefold()
+    if eco == "pypi":
+        name = re.sub(r"[-_.]+", "-", name)
+    # npm names are lowercase by rule; NuGet and PyPI compare case-insensitively.
+    return eco, name.casefold()
+
+
+@dataclass(frozen=True)
+class Package:
+    ecosystem: str
+    name: str
+    version: str
+    licences: tuple[str, ...]
+    occurrences: tuple[tuple[str, tuple[str, ...]], ...]  # (lockfile path, dependency groups)
+
+    @property
+    def sources(self) -> tuple[str, ...]:
+        return tuple(path for path, _ in self.occurrences)
+
+    @property
+    def expression(self) -> str:
+        usable = [item for item in self.licences if item.strip().casefold() not in UNUSABLE]
+        if not usable:
+            return ""
+        if len(usable) == 1:
+            return usable[0]
+        # Several declared licences must all be honoured: combine them conservatively.
+        return " AND ".join(f"({item})" for item in usable)
+
+
+def normalise(raw: object, root: str) -> list[dict[str, object]]:
+    """Reduce osv-scanner JSON to sorted package records. One record per package version."""
+    merged: dict[tuple[str, str, str], dict[str, object]] = {}
+    prefix = root.rstrip("/") + "/"
+    for result in sequence(mapping(raw).get("results", [])):
+        entry = mapping(result)
+        source = mapping(entry.get("source", {}))
+        path = string(source.get("path", ""))
+        path = path[len(prefix) :] if path.startswith(prefix) else path
+        for item in sequence(entry.get("packages", [])):
+            record = mapping(item)
+            info = mapping(record.get("package"))
+            ecosystem, name, version = (
+                string(info.get("ecosystem", "")),
+                string(info.get("name", "")),
+                string(info.get("version", "")),
+            )
+            if not (ecosystem and name and version):
+                raise Invalid("Scanner reported a package without ecosystem, name and version")
+            licences = sorted({string(value) for value in sequence(record.get("licenses", []) or [])})
+            groups = sorted({string(value) for value in sequence(record.get("dependency_groups", []) or [])})
+            key = (*package_key(ecosystem, name), version)
+            existing = merged.get(key)
+            if existing is None:
+                merged[key] = {
+                    "ecosystem": ecosystem,
+                    "name": name,
+                    "version": version,
+                    "licenses": licences,
+                    "occurrences": [{"path": path, "groups": groups}],
+                }
+            else:
+                existing["licenses"] = sorted(set(map(str, sequence(existing["licenses"]))) | set(licences))
+                occurrences = sequence(existing["occurrences"])
+                occurrences.append({"path": path, "groups": groups})
+                existing["occurrences"] = occurrences
+    for record in merged.values():
+        record["occurrences"] = sorted(sequence(record["occurrences"]), key=lambda value: canonical(value))
+    return [merged[key] for key in sorted(merged)]
+
+
+def make_packet(
+    packages: list[dict[str, object]],
+    lockfiles: list[str],
+    missing_lockfiles: list[str],
+    scanner: dict[str, object],
+) -> dict[str, object]:
+    body: dict[str, object] = {
+        "schema_version": SCHEMA_VERSION,
+        "scanner": scanner,
+        "lockfiles": sorted(set(lockfiles)),
+        "missing_lockfiles": sorted(set(missing_lockfiles)),
+        "packages": packages,
+    }
+    return {**body, "evidence_key": hashlib.sha256(canonical(body).encode()).hexdigest()}
+
+
+def verify_packet(value: object) -> dict[str, object]:
+    packet = mapping(value)
+    key = string(packet.get("evidence_key"))
+    body = {name: item for name, item in packet.items() if name != "evidence_key"}
+    if integer(packet.get("schema_version")) != SCHEMA_VERSION:
+        raise Invalid(f"Licence scan schema_version must be {SCHEMA_VERSION}")
+    if hashlib.sha256(canonical(body).encode()).hexdigest() != key:
+        raise Invalid("Licence scan evidence key does not match its contents")
+    return packet
+
+
+def packages_of(packet: dict[str, object]) -> list[Package]:
+    result = []
+    for item in sequence(packet["packages"]):
+        record = mapping(item)
+        occurrences = [mapping(value) for value in sequence(record["occurrences"])]
+        result.append(
+            Package(
+                string(record["ecosystem"]),
+                string(record["name"]),
+                string(record["version"]),
+                tuple(string(value) for value in sequence(record["licenses"])),
+                tuple(
+                    (string(value["path"]), tuple(string(group) for group in sequence(value["groups"])))
+                    for value in occurrences
+                ),
+            )
+        )
+    return result
+
+
+# --- Overrides ---------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Override:
+    ecosystem: str
+    name: str
+    version: str
+    licence: str
+    accept: str
+    evidence: str
+
+    @property
+    def key(self) -> tuple[str, str, str]:
+        return (*package_key(self.ecosystem, self.name), self.version)
+
+    @property
+    def label(self) -> str:
+        return f"{self.ecosystem}:{self.name}@{self.version}"
+
+
+def parse_overrides(value: object) -> list[Override]:
+    data = mapping(value)
+    if integer(data.get("schema_version")) != SCHEMA_VERSION:
+        raise Invalid(f"Licence overrides schema_version must be {SCHEMA_VERSION}")
+    result: list[Override] = []
+    seen: set[tuple[str, str, str]] = set()
+    for item in sequence(data.get("overrides", [])):
+        record = mapping(item)
+        allowed = {"ecosystem", "name", "version", "license", "accept", "evidence"}
+        if set(record) - allowed:
+            raise Invalid(f"Unknown override keys: {', '.join(sorted(set(record) - allowed))}")
+        override = Override(
+            string(record.get("ecosystem")),
+            string(record.get("name")),
+            string(record.get("version")),
+            string(record.get("license", "")),
+            string(record.get("accept", "")),
+            string(record.get("evidence", "")),
+        )
+        if not (override.ecosystem and override.name and override.version):
+            raise Invalid("Each override names an exact ecosystem, package and version")
+        if not override.evidence.strip():
+            raise Invalid(f"Override {override.label} must cite evidence")
+        if not (override.licence.strip() or override.accept.strip()):
+            raise Invalid(f"Override {override.label} must set a license, an accept reason, or both")
+        if override.key in seen:
+            raise Invalid(f"Duplicate override for {override.label}")
+        seen.add(override.key)
+        result.append(override)
+    return result
+
+
+# --- Evaluation --------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Finding:
+    package: Package
+    expression: str
+    status: str
+    overridden: bool
+    note: str = ""
+
+
+@dataclass
+class Evaluation:
+    findings: list[Finding] = field(default_factory=list)
+    missing_lockfiles: list[str] = field(default_factory=list)
+    stale_overrides: list[str] = field(default_factory=list)
+    issues: list[str] = field(default_factory=list)
+
+    def count(self, status: str) -> int:
+        return sum(1 for finding in self.findings if finding.status == status)
+
+    @property
+    def violations(self) -> list[Finding]:
+        return [item for item in self.findings if item.status in (REVIEW, UNKNOWN, DENY)]
+
+    @property
+    def error_code(self) -> int:
+        """0 compliant; 1 licence violation; 2 incomplete evidence. Advisory, never an exit status."""
+        if self.issues or self.missing_lockfiles:
+            return 2
+        return 1 if self.violations else 0
+
+    @property
+    def decision(self) -> str:
+        return ("COMPLIANT", "VIOLATION", "INCOMPLETE")[self.error_code]
+
+
+def evaluate(packet: dict[str, object], policy: Policy, overrides: list[Override]) -> Evaluation:
+    by_key = {override.key: override for override in overrides}
+    used: set[tuple[str, str, str]] = set()
+    evaluation = Evaluation()
+    evaluation.missing_lockfiles = [
+        path for path in map(str, sequence(packet["missing_lockfiles"])) if not policy.excluded(path)
+    ]
+    shipped = [path for path in map(str, sequence(packet["lockfiles"])) if not policy.excluded(path)]
+    if not shipped and not evaluation.missing_lockfiles:
+        evaluation.issues.append("No lockfiles were scanned; the dependency set cannot be established")
+
+    for package in packages_of(packet):
+        key = (*package_key(package.ecosystem, package.name), package.version)
+        override = by_key.get(key)
+        if override:
+            used.add(key)
+        expression = override.licence if override and override.licence else package.expression
+        in_scope = [groups for path, groups in package.occurrences if not policy.excluded(path)]
+        # Dev only when every shipped occurrence is in a dev group; an ungrouped occurrence ships.
+        dev_only = all(
+            groups and all(g.casefold() in policy.dev_groups for g in groups) for groups in in_scope
+        )
+        if not in_scope:
+            evaluation.findings.append(
+                Finding(package, expression, EXCLUDED, bool(override), "excluded path")
+            )
+            continue
+        if dev_only:
+            evaluation.findings.append(Finding(package, expression, EXCLUDED, bool(override), "dev only"))
+            continue
+        status = classify(expression, policy)
+        note = ""
+        if status == REVIEW and override and override.accept.strip():
+            status, note = ACCEPTED, override.accept.strip()
+        evaluation.findings.append(Finding(package, expression, status, bool(override), note))
+
+    evaluation.stale_overrides = sorted(item.label for item in overrides if item.key not in used)
+    return evaluation
diff --git a/tests/test_licences.py b/tests/test_licences.py
new file mode 100644
index 0000000..9e6449d
--- /dev/null
+++ b/tests/test_licences.py
@@ -0,0 +1,385 @@
+import hashlib
+import io
+import json
+import sys
+
+import pytest
+from hypothesis import given
+from hypothesis import strategies as st
+
+from estate_actions import licence_scan
+from estate_actions.data import Invalid
+from estate_actions.licence_cli import run
+from estate_actions.licence_report import render
+from estate_actions.licences import (
+    ACCEPTED,
+    ALLOW,
+    DEFAULT_POLICY,
+    DENY,
+    EXCLUDED,
+    REVIEW,
+    SEVERITY,
+    UNKNOWN,
+    Policy,
+    classify,
+    evaluate,
+    make_packet,
+    normalise,
+    parse_overrides,
+    verify_packet,
+)
+
+POLICY = Policy.parse(DEFAULT_POLICY)
+
+
+def scanner_output(root="/repo", *results):
+    """The osv-scanner v2 JSON shape this prototype reads: results[].source and results[].packages[]."""
+    return {
+        "results": [
+            {
+                "source": {"path": f"{root}/{path}", "type": "lockfile"},
+                "packages": [
+                    {
+                        "package": {"name": name, "version": version, "ecosystem": ecosystem},
+                        "licenses": licences,
+                        "dependency_groups": groups,
+                    }
+                    for ecosystem, name, version, licences, groups in packages
+                ],
+            }
+            for path, packages in results
+        ]
+    }
+
+
+def packet(*results, missing=()):
+    raw = scanner_output("/repo", *results)
+    lockfiles = [path for path, _ in results]
+    return make_packet(normalise(raw, "/repo"), lockfiles, list(missing), {"name": "osv-scanner"})
+
+
+def statuses(evaluation):
+    return {finding.package.name: finding.status for finding in evaluation.findings}
+
+
+@pytest.mark.parametrize(
+    ("expression", "expected"),
+    [
+        ("MIT", ALLOW),
+        ("mit", ALLOW),
+        ("MIT OR GPL-3.0-only", ALLOW),
+        ("MIT AND GPL-3.0-only", DENY),
+        ("(MIT OR Apache-2.0) AND MPL-2.0", REVIEW),
+        ("GPL-2.0-only OR LGPL-2.1-only", REVIEW),
+        ("Apache-2.0 WITH LLVM-exception", ALLOW),
+        ("MIT AND LicenseRef-Custom", UNKNOWN),
+        ("MIT OR LicenseRef-Custom", ALLOW),
+        ("non-standard", UNKNOWN),
+        ("UNKNOWN", UNKNOWN),
+        ("", UNKNOWN),
+        ("MIT AND", UNKNOWN),
+        ("(MIT", UNKNOWN),
+        ("MIT Apache-2.0", UNKNOWN),
+        ("MIT/Apache-2.0", UNKNOWN),
+    ],
+)
+def test_spdx_expressions_classify_by_severity(expression, expected):
+    assert classify(expression, POLICY) == expected
+
+
+def test_a_policy_can_list_an_exact_exception_combination():
+    policy = Policy.merge(
+        DEFAULT_POLICY,
+        {"allow": ["MIT", "GPL-2.0-only WITH Classpath-exception-2.0"], "deny": ["GPL-2.0-only"]},
+    )
+    assert classify("GPL-2.0-only WITH Classpath-exception-2.0", policy) == ALLOW
+    assert classify("GPL-2.0-only", policy) == DENY
+
+
+licence_ids = st.sampled_from(
+    ["MIT", "Apache-2.0", "MPL-2.0", "GPL-3.0-only", "LicenseRef-X", "BSD-3-Clause"]
+)
+
+
+@given(licence_ids, licence_ids)
+def test_or_takes_the_least_and_and_the_most_severe_option(left, right):
+    a, b = classify(left, POLICY), classify(right, POLICY)
+    assert classify(f"{left} OR {right}", POLICY) == min(a, b, key=SEVERITY.__getitem__)
+    assert classify(f"{left} AND {right}", POLICY) == max(a, b, key=SEVERITY.__getitem__)
+    assert classify(f"{left} OR {right}", POLICY) == classify(f"{right} OR {left}", POLICY)
+
+
