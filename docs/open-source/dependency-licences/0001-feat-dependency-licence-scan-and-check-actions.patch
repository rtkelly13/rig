+++ b/src/estate_actions/licence_scan.py
@@ -0,0 +1,121 @@
+"""Licence scan phase: fetch a pinned osv-scanner, run it on lockfiles, freeze the result.
+
+This is the only licence step with side effects (one download, one subprocess, deps.dev lookups
+made by the scanner). Everything it learns is written to a fingerprinted packet for the pure
+``licences`` evaluation.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import stat
+import subprocess
+import urllib.request
+from pathlib import Path
+
+from estate_actions.data import Invalid, decode, mapping, sequence, string
+
+RELEASE_URL = "https://github.com/google/osv-scanner/releases/download/v{version}/osv-scanner_{platform}"
+
+# Directories never holding a project's own manifests.
+SKIPPED = {".git", "node_modules", ".venv", "venv", "bin", "obj", "temp", ".worktrees", "dist", "build"}
+DOTNET_PROJECTS = (".csproj", ".fsproj", ".vbproj")
+NODE_LOCKFILES = ("pnpm-lock.yaml", "package-lock.json", "yarn.lock", "bun.lock")
+PYTHON_LOCKFILES = ("uv.lock", "poetry.lock", "pdm.lock", "pylock.toml")
+# osv-scanner exit codes: 0 clean, 1 findings (vulnerabilities or licence violations), 128 no packages.
+SCANNER_OK = {0, 1, 128}
+
+
+def runner_platform() -> str:
+    system = {"Linux": "linux", "macOS": "darwin", "Windows": "windows"}.get(
+        os.environ.get("RUNNER_OS", "Linux")
+    )
+    arch = {"X64": "amd64", "ARM64": "arm64"}.get(os.environ.get("RUNNER_ARCH", "X64"))
+    if not system or not arch:
+        raise Invalid("Unsupported runner platform for osv-scanner")
+    return f"{system}_{arch}" + (".exe" if system == "windows" else "")
+
+
+def load_pin(path: Path) -> dict[str, object]:
+    pin = mapping(decode(path.read_text(encoding="utf-8")))
+    if not string(pin.get("version")):
+        raise Invalid(f"osv-scanner version is not pinned in {path.name}")
+    mapping(pin.get("sha256"))
+    sequence(pin.get("arguments"))
+    return pin
+
+
+def fetch_scanner(pin: dict[str, object], platform: str, directory: Path) -> Path:
+    """Download the pinned release asset and refuse it unless its SHA-256 matches the pin."""
+    expected = string(mapping(pin["sha256"]).get(platform, "")).lower()
+    if len(expected) != 64:
+        raise Invalid(f"No SHA-256 pinned for osv-scanner on {platform}")
+    url = RELEASE_URL.format(version=string(pin["version"]), platform=platform)
+    target = directory / f"osv-scanner-{pin['version']}-{platform}"
+    if not target.exists() or hashlib.sha256(target.read_bytes()).hexdigest() != expected:
+        with urllib.request.urlopen(url, timeout=120) as response:  # noqa: S310 - fixed https URL
+            content: bytes = response.read()
+        actual = hashlib.sha256(content).hexdigest()
+        if actual != expected:
+            raise Invalid(f"osv-scanner download does not match its pinned SHA-256 (got {actual})")
+        target.write_bytes(content)
+    target.chmod(target.stat().st_mode | stat.S_IXUSR)
+    return target
+
+
+def run_scanner(binary: Path, arguments: list[str], root: Path, output: Path) -> tuple[int, object]:
+    command = [str(binary), "scan", "source", "--recursive", "--format", "json", "--output", str(output)]
+    command += [*arguments, str(root)]
+    completed = subprocess.run(command, capture_output=True, text=True, timeout=900, check=False)
+    if completed.returncode not in SCANNER_OK:
+        tail = (completed.stderr or completed.stdout).strip().splitlines()[-5:]
+        raise Invalid(f"osv-scanner failed with exit code {completed.returncode}: {' / '.join(tail)}")
+    if completed.returncode == 128 or not output.exists():
+        return completed.returncode, {"results": []}
+    return completed.returncode, decode(output.read_text(encoding="utf-8"))
+
+
+def lockfiles_of(raw: object, root: Path) -> list[str]:
+    prefix = str(root).rstrip("/") + "/"
+    paths = []
+    for result in sequence(mapping(raw).get("results", [])):
+        path = string(mapping(mapping(result).get("source", {})).get("path", ""))
+        paths.append(path[len(prefix) :] if path.startswith(prefix) else path)
+    return sorted(set(paths))
+
+
+def missing_lockfiles(root: Path) -> list[str]:
+    """Manifests whose dependency set no committed lockfile pins. Their licences are unknowable."""
+    missing: list[str] = []
+    for directory, names, files in os.walk(root):
+        names[:] = sorted(name for name in names if name not in SKIPPED)
+        here = Path(directory)
+        relative = here.relative_to(root).as_posix()
+
+        def show(name: str, base: str = relative) -> str:
+            return name if base == "." else f"{base}/{name}"
+
+        for name in sorted(files):
+            if name.endswith(DOTNET_PROJECTS) and "packages.lock.json" not in files:
+                missing.append(show(name))
+        if "package.json" in files and not ancestor_has(here, root, NODE_LOCKFILES):
+            missing.append(show("package.json"))
+        if (
+            "pyproject.toml" in files
+            and "[project]" in (here / "pyproject.toml").read_text(encoding="utf-8", errors="replace")
+            and not ancestor_has(here, root, PYTHON_LOCKFILES)
+        ):
+            missing.append(show("pyproject.toml"))
+    return missing
+
+
+def ancestor_has(directory: Path, root: Path, names: tuple[str, ...]) -> bool:
+    """Workspace lockfiles live at the workspace root, above member manifests."""
+    current = directory
+    while True:
+        if any((current / name).exists() for name in names):
+            return True
+        if current == root or root not in current.parents:
+            return False
+        current = current.parent
