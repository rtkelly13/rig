+def test_scan_then_check_end_to_end_with_a_stand_in_scanner(tmp_path, monkeypatch):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    (repo / "uv.lock").write_text("")
+    (repo / ".github").mkdir()
+    (repo / ".github" / "licence-overrides.json").write_text(
+        json.dumps(
+            {
+                "schema_version": 1,
+                "overrides": [
+                    {
+                        "ecosystem": "PyPI",
+                        "name": "certifi",
+                        "version": "1",
+                        "accept": "unmodified",
+                        "evidence": "x",
+                    }
+                ],
+            }
+        )
+    )
+    canned = scanner_output(
+        str(repo),
+        ("uv.lock", [("PyPI", "attrs", "25.1.0", ["MIT"], []), ("PyPI", "certifi", "1", ["MPL-2.0"], [])]),
+    )
+    fake = tmp_path / "fake-osv-scanner"
+    fake.write_text(
+        f"#!{sys.executable}\nimport json, sys\n"
+        "args = sys.argv[1:]\n"
+        f"open(args[args.index('--output') + 1], 'w').write(json.dumps({canned!r}))\n"
+        "sys.exit(1)\n"
+    )
+    fake.chmod(0o755)
+    pin = tmp_path / "scanner.json"
+    pin.write_text(json.dumps({"version": "2.0.0", "sha256": {}, "arguments": ["--all-packages"]}))
+    output_file = tmp_path / "github-output"
+    monkeypatch.chdir(repo)
+    monkeypatch.setenv("GITHUB_OUTPUT", str(output_file))
+    monkeypatch.setenv("RUNNER_TEMP", str(tmp_path / "runner"))
+    monkeypatch.setenv("PIN_FILE", str(pin))
+    monkeypatch.setenv("SCANNER_BINARY", str(fake))
+    monkeypatch.setenv("SCAN_ROOT", str(repo))
+
+    assert run("scan") == 0
+    scanned = outputs(output_file)
+    assert scanned["error-code"] == "0"
+    output_file.unlink()
+
+    monkeypatch.setenv("SCAN_FILE", scanned["scan-file"])
+    assert run("check") == 0
+    checked = outputs(output_file)
+    assert checked["decision"] == "COMPLIANT"
+    assert checked["error-code"] == "0"
+    assert checked["evidence-key"] == scanned["evidence-key"]
+    inventory = json.loads(
+        (tmp_path / "runner" / "estate-actions" / "licences" / "inventory.json").read_text()
+    )
+    assert {item["name"]: item["status"] for item in inventory} == {"attrs": ALLOW, "certifi": ACCEPTED}
+
