+def outputs(path):
+    text = path.read_text()
+    result, lines = {}, iter(text.splitlines())
+    for line in lines:
+        key, delimiter = line.split("<<", 1)
+        value = []
+        for item in lines:
+            if item == delimiter:
+                break
+            value.append(item)
+        result[key] = "\n".join(value)
+    return result
+
