{
  "name": "Review",
  "launch": [
    {
      "name": "VS Code Workspace",
      "type": "app",
      "delay_ms": 1600,
      "path": "{vscode-path}",
      "args": [
        "--new-window",
        "{rig-root}\\rig.code-workspace"
      ],
      "summary": "Opens the multi-root workspace file in VS Code for cross-repo code review, on the left half of screen 1 beside Fork.",
      "placement": {
        "screen": 1,
        "layout": {
          "mode": "halves",
          "slot": 1,
          "orientation": "vertical"
        }
      },
      "window_title": "(Workspace)",
      "window_process_name": "Code.exe",
      "window_wait_timeout_ms": 30000
    },
    {
      "name": "Rig Web",
      "type": "command",
      "delay_ms": 2200,
      "command": "rig tools ensure web \u0026\u0026 \u0022{chrome-path}\u0022 --user-data-dir=\u0022{chrome-user-data}\u0022 --profile-directory=\u0022{chrome-profile-personal}\u0022 --app=http://127.0.0.1:8090",
      "cwd": "{rig-root}",
      "summary": "Starts the rig web dashboard service if it is not already answering, then opens it as a Chrome app window full-screen on screen 2. Replaces the prs-to-review checklist.",
      "placement": {
        "screen": 2,
        "layout": {
          "mode": "full",
          "slot": 1
        }
      },
      "window_title": "Rig // Estate Management",
      "window_process_name": "chrome.exe",
      "window_wait_timeout_ms": 45000
    },
    {
      "name": "Fork",
      "type": "app",
      "delay_ms": 1200,
      "path": "{fork-path}",
      "summary": "Opens Fork on the right half of screen 1, beside VS Code, for inspecting branches and diffs while reviewing.",
      "placement": {
        "screen": 1,
        "layout": {
          "mode": "halves",
          "slot": 2,
          "orientation": "vertical"
        }
      },
      "window_process_name": "Fork.exe"
    }
  ]
}
