{
  "name": "Admin",
  "launch": [
    {
      "name": "Google - Work Profile",
      "type": "app",
      "delay_ms": 1400,
      "path": "{chrome-path}",
      "args": [
        "--user-data-dir={chrome-user-data}",
        "--profile-directory={chrome-profile-work}",
        "--new-window",
        "https://mail.google.com/",
        "https://meet.google.com/",
        "https://calendar.google.com/"
      ],
      "summary": "Opens one Chrome window with the work profile, with Gmail, Google Meet and Calendar tabs, filling screen 1.",
      "placement": {
        "screen": 1,
        "layout": {
          "mode": "full",
          "slot": 1
        }
      },
      "window_process_name": "chrome.exe"
    },
    {
      "name": "Slack",
      "type": "app",
      "delay_ms": 1600,
      "path": "{slack-path}",
      "summary": "Slack, full screen 2.",
      "placement": {
        "screen": 2,
        "layout": {
          "mode": "full",
          "slot": 1
        }
      },
      "window_process_name": "slack.exe"
    },
    {
      "name": "1Password",
      "type": "app",
      "delay_ms": 900,
      "path": "{onepassword-path}",
      "summary": "1Password, full screen 3.",
      "placement": {
        "screen": 3,
        "layout": {
          "mode": "full",
          "slot": 1
        }
      },
      "window_process_name": "1Password.exe"
    }
  ]
}
