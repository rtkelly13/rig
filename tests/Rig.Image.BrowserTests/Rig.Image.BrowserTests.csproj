<Project Sdk="Microsoft.NET.Sdk">
  <!-- The authoritative renderer in a real Chromium. Its own project so launching a browser never slows Rig.Image.Tests. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Rig.Image/Rig.Image.csproj" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup Label="Shared fixtures">
    <Compile Include="../Rig.Image.Tests/OracleFixture.cs" Link="OracleFixture.cs" />
    <None Include="../Rig.Image.Tests/Oracle/**" Link="Oracle/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
