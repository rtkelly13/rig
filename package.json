{
  "name": "rig-styles",
  "private": true,
  "type": "module",
  "description": "Tailwind build for the image-drift preview gallery templates.",
  "scripts": {
    "css:build": "tailwindcss -i styles/gallery.src.css -o src/rig/image_drift/templates/gallery.css --minify",
    "css:watch": "tailwindcss -i styles/gallery.src.css -o src/rig/image_drift/templates/gallery.css --watch",
    "css:check": "tailwindcss -i styles/gallery.src.css -o /tmp/gallery.check.css --minify && cmp -s /tmp/gallery.check.css src/rig/image_drift/templates/gallery.css && echo 'gallery.css is up to date' || (echo 'gallery.css is stale - run: pnpm css:build' && exit 1)",
    "web:build": "node scripts/build-web.mjs",
    "web:check": "node scripts/build-web.mjs --check",
    "web:typecheck": "tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@rtkelly-labs/design-system": "0.19.0",
    "@tailwindcss/cli": "^4.1.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.18.0"
}
