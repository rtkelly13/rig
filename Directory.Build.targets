<Project>
  <!-- PrivateAssets for Paket's references (foundations' Common.targets); the banned-API analyzer is always private.
       Also private: CsWin32 with the Win32 metadata and docs packages Paket lists as direct references. CsWin32 is a
       build-time source generator; without the flag its generator and those packages flow through every project that
       references Rig.Core. -->
  <PropertyGroup>
    <PaketPrivatePackages>Microsoft.Windows.CsWin32;Microsoft.Windows.SDK.Win32Docs;Microsoft.Windows.SDK.Win32Metadata;Microsoft.Windows.WDK.Win32Metadata</PaketPrivatePackages>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)paket-files/build/rtkelly-labs/foundations/dotnet/Common.targets" />
</Project>
