root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 116

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0009.severity = warning
# rig lowercases on purpose: keys and stems match what the Python wrote, never compared culture-sensitively.
dotnet_diagnostic.CA1308.severity = none

# Functional and performance enforcement
csharp_prefer_static_anonymous_function = true:warning
csharp_prefer_static_local_function = true:warning
dotnet_diagnostic.RS0030.severity = suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion

# Strict guardrails for gh pr and devenv tooling
[src/Rig.Cli/Gh/**/*.cs]
dotnet_diagnostic.RS0030.severity = warning
csharp_prefer_static_anonymous_function = true:warning
csharp_prefer_static_local_function = true:warning

# Tests: sentence-style names with underscores, and no ConfigureAwait in test bodies.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
# Test types and fakes are public for xUnit and never a shipped API: no null guards, plain lists.
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1515.severity = none
