# Custom typing stub for standard library sqlite3 to provide strongly-typed cursor results
from collections.abc import Callable, Iterable
from types import TracebackType
from typing import Self

class Error(Exception): ...
class DatabaseError(Error): ...
class OperationalError(DatabaseError): ...
class IntegrityError(DatabaseError): ...

class Cursor:
    lastrowid: int | None
    rowcount: int
    def execute(self, sql: str, parameters: Iterable[object] = ...) -> Self: ...
    def executemany(self, sql: str, seq_of_parameters: Iterable[Iterable[object]]) -> Self: ...
    def fetchone(self) -> tuple[object, ...] | None: ...
    def fetchall(self) -> list[tuple[object, ...]]: ...
    def fetchmany(self, size: int = ...) -> list[tuple[object, ...]]: ...
    def close(self) -> None: ...
    @property
    def description(self) -> tuple[tuple[str, object, object, object, object, object, object], ...] | None: ...

class Connection:
    total_changes: int
    def cursor(self) -> Cursor: ...
    def execute(self, sql: str, parameters: Iterable[object] = ...) -> Cursor: ...
    def executemany(self, sql: str, seq_of_parameters: Iterable[Iterable[object]]) -> Cursor: ...
    def executescript(self, sql_script: str) -> Cursor: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_val: BaseException | None,
        exc_tb: TracebackType | None,
    ) -> bool | None: ...
    def backup(
        self,
        target: Connection,
        *,
        pages: int = -1,
        progress: Callable[[int, int, int], object] | None = None,
        name: str = "main",
        sleep: float = 0.25,
    ) -> None: ...

def connect(
    database: str | bytes | object,
    timeout: float = 5.0,
    detect_types: int = 0,
    isolation_level: str | None = "DEFERRED",
    check_same_thread: bool = True,
    factory: type[Connection] | None = None,
    cached_statements: int = 128,
    uri: bool = False,
    autocommit: bool = False,
) -> Connection: ...
