from typing import Self

class VirtualDesktop:
    def __init__(
        self, number: int | None = None, desktop_id: object = None, desktop: object = None, current: bool = False
    ) -> None: ...
    @classmethod
    def current(cls) -> Self: ...
    @classmethod
    def create(cls) -> Self: ...
    @property
    def number(self) -> int: ...
    @property
    def name(self) -> str: ...
    def rename(self, name: str) -> None: ...
    def remove(self, fallback: VirtualDesktop | None = None) -> None: ...
    def go(self, allow_set_foreground: bool = True) -> None: ...

class AppView:
    def __init__(self, hwnd: int | None = None, view: object = None) -> None: ...
    @property
    def hwnd(self) -> int: ...
    @property
    def desktop(self) -> VirtualDesktop: ...
    def move(self, desktop: VirtualDesktop) -> None: ...
    def is_on_current_desktop(self) -> bool: ...

def get_virtual_desktops() -> list[VirtualDesktop]: ...
