source https://api.nuget.org/v3/index.json

storage: none
strategy: min
lowest_matching: true
framework: net10.0, net11.0

// MCP
nuget ModelContextProtocol == 2.4.0
nuget ModelContextProtocol.AspNetCore == 2.4.0

// Command line
nuget DotMake.CommandLine == 3.7.0
nuget Spectre.Console == 0.57.2
nuget System.CommandLine == 2.0.13

// C4 viewer: notes to HTML
nuget Markdig == 1.5.1

// Vault
nuget YamlDotNet == 18.1.0

// Connectivity: pyproject.toml manifests
nuget Tomlyn == 2.10.0

// Orca
nuget Microsoft.Data.Sqlite == 10.0.13

// Desktop
nuget Microsoft.Windows.CsWin32 == 0.3.366

// Image stack evaluation (experiments/image-stack-eval, issue #317)
nuget SixLabors.ImageSharp == 4.1.3
nuget Svg.Skia == 5.2.3

// Tests
nuget xunit.v3.mtp-v2 == 4.0.3
nuget CsCheck == 5.0.1
nuget coverlet.MTP == 10.1.0
// Matches the Microsoft.Testing.Platform version xunit.v3.mtp-v2 brings in.
nuget Microsoft.Testing.Extensions.TrxReport == 2.5.2
nuget NetArchTest.Rules == 1.3.2
nuget Reqnroll.xunit.v3 == 3.3.4

// Browser tests
nuget Microsoft.Playwright == 1.64.1

// Images
nuget SkiaSharp.NativeAssets.Linux.NoDependencies == 4.148.0

// Geometry
nuget NetTopologySuite == 2.6.0

// Analyzers
nuget Microsoft.CodeAnalysis.BannedApiAnalyzers == 5.6.0

// The Rig.Paket sidecar parses Paket files with Paket's own parsers (ADR 0025). Its own group keeps Paket.Core, FSharp.Core,
// Newtonsoft.Json and the old NETStandard 1.x packages out of the Main lock, which every other project resolves from.
group Sidecar
  source https://api.nuget.org/v3/index.json

  storage: none
  strategy: min
  lowest_matching: true
  framework: net10.0, net11.0

  nuget Paket.Core == 12.0.0
  // Paket.Core's transitive floors carry advisories (NU1902/NU1903); raise them past the fix.
  nuget System.Net.Http == 4.3.4
  nuget System.Security.Cryptography.Pkcs == 10.0.13
  nuget System.Security.Cryptography.X509Certificates == 4.3.2
