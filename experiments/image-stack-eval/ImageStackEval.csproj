<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Evaluation spike for issue #317. Deliberately outside rig.slnx and CI: it needs a Chromium binary and
       the Python reference dump. The shipping bar (warnings as errors, latest-all analyzers) is relaxed
       because this is throwaway measurement code, not product code. -->
  <PropertyGroup>
    <!-- Library by default: the command-ownership gate refuses any other executable project. Run it with -p:OutputType=Exe. -->
    <OutputType Condition="'$(OutputType)' == ''">Library</OutputType>
    <RootNamespace>ImageStackEval</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <AnalysisModePerformance>Default</AnalysisModePerformance>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1812</NoWarn>
  </PropertyGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>