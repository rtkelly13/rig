# C# raw string literals take the file's line endings; tests compare them with \n output.
*.cs text eol=lf
# Embedded templates are written byte for byte; keep them LF on every checkout.
src/Rig.Core/Governance/Templates/** text eol=lf
.github/workflows/*.lock.yml linguist-generated=true merge=ours
*.svg -text
# Compiled rig SPA artifacts are committed so the Python server needs no Node runtime.
src/rig/web_host/templates/app_assets/*.js -text linguist-generated=true
src/rig/web_host/templates/app_assets/*.css -text linguist-generated=true
# Compiled Tailwind stylesheets, built from styles/*.src.css by `pnpm css:build`.
tools/image-drift/src/image_drift/templates/gallery.css -text linguist-generated=true
src/rig/c4_okf/static/c4.css -text linguist-generated=true
