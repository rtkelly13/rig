<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rig.Core</RootNamespace>
    <!-- LibraryImport generates unsafe marshalling stubs (Otel/DetachedStart.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Its parser only: rig applies PyYAML's tag resolution itself (Vault/Frontmatter.cs). -->
    <PackageReference Include="YamlDotNet" />
    <!-- Reads pyproject.toml manifests for the estate graph (Connectivity/Manifests.cs). -->
    <PackageReference Include="Tomlyn" />
    <!-- Reads Orca's profile-state database, read-only (Orca/OrcaProfile.cs). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Build time only: generates the UI Automation COM interop from Windows' metadata (Desktop/Windows/NativeMethods.txt). -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Desktop/Windows/NativeMethods.txt" />
    <AdditionalFiles Include="Desktop/Windows/NativeMethods.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Claude Code SessionEnd hook devenv installs (Devenv/SessionLedger.cs). -->
    <EmbeddedResource Include="Devenv/session-ledger.mjs" LogicalName="Rig.Core.Devenv.session-ledger.mjs" />
    <EmbeddedResource Include="Devenv/gh-scopes.json" LogicalName="Rig.Core.Devenv.gh-scopes.json" />
    <EmbeddedResource Include="Devenv/dev-tools.json" LogicalName="Rig.Core.Devenv.dev-tools.json" />
    <EmbeddedResource Include="../../config/chrome-site-groups.json" LogicalName="Rig.Core.Chrome.chrome-site-groups.json" />
    <!-- The estate router template `workspace sync` writes as the personal folder's AGENTS.md (Workspace/EstateSync.cs). -->
    <EmbeddedResource Include="Workspace/root-agents-md.md" LogicalName="Rig.Core.Workspace.root-agents-md.md" />
    <!-- The community health files `repo-governance sync-templates` writes (Governance/OssTemplates.cs). -->
    <EmbeddedResource Include="Governance/Templates/oss/*.jinja" LogicalName="Rig.Core.Governance.Templates.oss.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Governance/Templates/policy/*.jinja" LogicalName="Rig.Core.Governance.Templates.policy.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Governance/Templates/review/*" LogicalName="Rig.Core.Governance.Templates.review.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
