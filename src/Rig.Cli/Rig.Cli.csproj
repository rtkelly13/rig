<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rig command line (ADR 0022). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rig.Cli</RootNamespace>
    <AssemblyName>rig</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rig</ToolCommandName>
    <PackageId>Rig.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>rig, the personal estate command line.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rig.Core/Rig.Core.csproj" />
    <ProjectReference Include="../Rig.Image/Rig.Image.csproj" />
    <ProjectReference Include="../Rig.Web/Rig.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rig.Cli.Tests" />
  </ItemGroup>
  <Import Project="..\Rig.Paket\Rig.Paket.Sidecar.targets" />
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>