<Project Sdk="Microsoft.NET.Sdk">
  <!-- The image pipeline (ADR 0024, #321): two SVG renderers, the raster work, the drift metrics and the cross-check. -->
  <PropertyGroup>
    <RootNamespace>Rig.Image</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The authoritative renderer. The package pins the Chromium revision, so CI and a developer install the same browser. -->
    <PackageReference Include="Microsoft.Playwright" />
    <!-- The fast renderer, no browser. SkiaSharp is used only inside it. -->
    <PackageReference Include="Svg.Skia" />
    <!-- Svg.Skia throws on Linux without a native Skia; the macOS and Windows assets arrive with SkiaSharp itself. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rig.Image.Simplifier/Rig.Image.Simplifier.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Frozen from the Python builders before they were retired (ADR 0024). -->
    <!-- The gallery page: one HTML fragment per piece of markup and the compiled Tailwind stylesheet, rebuilt by `pnpm css:build`. -->
    <EmbeddedResource Include="Gallery/gallery.css" LogicalName="Rig.Image.gallery.gallery.css" />
    <EmbeddedResource Include="Gallery/templates/*.html" LogicalName="Rig.Image.gallery.templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="feature-regions.json" LogicalName="Rig.Image.feature-regions.json" />
    <!-- The hand-tuned master and favicon SVGs and the labs manifest, embedded from builder-assets/. -->
    <EmbeddedResource Include="builder-assets/rtkelly-labs/manifest.json" LogicalName="Rig.Image.builder_assets.rtkelly-labs.manifest.json" />
    <EmbeddedResource Include="builder-assets/rtkelly-labs/master.svg" LogicalName="Rig.Image.builder_assets.rtkelly-labs.master.svg" />
    <EmbeddedResource Include="builder-assets/rtkelly-labs/favicon.svg" LogicalName="Rig.Image.builder_assets.rtkelly-labs.favicon.svg" />
    <EmbeddedResource Include="builder-assets/parquet-source-generator/master.svg" LogicalName="Rig.Image.builder_assets.parquet-source-generator.master.svg" />
    <EmbeddedResource Include="builder-assets/parquet-source-generator/favicon.svg" LogicalName="Rig.Image.builder_assets.parquet-source-generator.favicon.svg" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rig.Image.Tests" />
    <InternalsVisibleTo Include="Rig.Image.BrowserTests" />
    <InternalsVisibleTo Include="Rig.Cli.Tests" />
    <InternalsVisibleTo Include="rig" />
    <InternalsVisibleTo Include="Rig.Web" />
    <InternalsVisibleTo Include="Rig.Web.Tests" />
  </ItemGroup>
</Project>
