<Project Sdk="Microsoft.NET.Sdk">
  <!-- rigw: rig as a Windows app, which opens no console, for the scheduled tasks. It hands its arguments to rig's own entry point. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Rig.Launcher</RootNamespace>
    <AssemblyName>rigw</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rig.Cli/Rig.Cli.csproj" />
  </ItemGroup>
</Project>
