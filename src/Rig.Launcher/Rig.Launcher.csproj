<Project Sdk="Microsoft.NET.Sdk">
  <!-- rigw: rig as a Windows app, which opens no console, for the scheduled tasks. It hands its arguments to rig's own entry point. -->
  <PropertyGroup>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Release'">Exe</OutputType>
    <RootNamespace>Rig.Launcher</RootNamespace>
    <AssemblyName>rigw</AssemblyName>
    <IsPackable>false</IsPackable>
    <Version>0.1.0</Version>
    <Company>Ryan Kelly</Company>
    <Product>rig</Product>
    <AssemblyTitle>rig (windowless)</AssemblyTitle>
    <Description>Runs a rig command without a console window, for rig's scheduled tasks.</Description>
    <ApplicationManifest>rigw.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rig.Cli/Rig.Cli.csproj" />
  </ItemGroup>
</Project>
