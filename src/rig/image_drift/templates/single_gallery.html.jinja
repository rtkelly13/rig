{% extends "base.html.jinja" %}

{% block title %}{{ project_name }} Logo Macro Element Analysis{% endblock %}
{% block subtitle %}Deterministic Logo Reconciliation &mdash; Reference vs Target SVG Vector{% endblock %}

{% block metric_note %}
  <p class="text-caption leading-relaxed text-content-secondary">
    Composite {{ "%.2f"|format(candidates[0].composite_pct) }}% &mdash;
    full frame {{ "%.2f"|format(candidates[0].full_pct) }}%
  </p>
{% endblock %}

{% block content %}
  <div class="mb-7 grid w-full max-w-325 grid-cols-auto-fit gap-5">
    <article class="panel card-shadow relative flex flex-col items-center border-2 border-accent-tertiary p-5">
      <div class="ribbon bg-linear-to-r from-accent-tertiary to-palette-magenta text-content-inverse">&#128204; Canonical Reference</div>
      <h3 class="mt-3 mb-1.5 text-center text-body text-content-primary">{{ reference_name }}</h3>
      <p class="mb-3 min-h-8.5 text-center text-caption text-content-secondary">The source artwork the target is scored against.</p>
      <img class="size-52.5 rounded-xl object-contain" src="{{ reference_hero }}" alt="Canonical reference">
      <div class="badge-ref">Composite: 0.00% (by definition)</div>
    </article>
    <article class="panel card-shadow relative flex flex-col items-center border-2 border-accent-primary p-5">
      <h3 class="mt-3 mb-1.5 text-center text-body text-content-primary">{{ candidates[0].name }}</h3>
      <p class="mb-3 min-h-8.5 text-center text-caption text-content-secondary">{{ candidates[0].description }}</p>
      <img class="size-52.5 rounded-xl object-contain" src="{{ candidates[0].hero }}" alt="Target SVG">
      <div class="{{ candidates[0].badge_class }}">
        Composite: {{ "%.2f"|format(candidates[0].composite_pct) }}%
      </div>
      <div class="mt-1.5 text-caption text-content-muted">Full frame: {{ "%.2f"|format(candidates[0].full_pct) }}%</div>
    </article>
  </div>

  <h2 class="section-title">High-Resolution Macro Element Zoom Inspection</h2>
{% include "_feature_matrix.html.jinja" %}
{% endblock %}
