{% extends "base.html.jinja" %}

{% block title %}{{ project_name }} — Pick a Base{% endblock %}
{% block subtitle %}Choose the base to build the next round on{% endblock %}

{% block metric_note %}
  <p class="text-caption leading-relaxed text-content-secondary">
    No scores here on purpose. Drift measures similarity to the source raster, which the mark
    deviates from by design, so it cannot tell you which of these looks best. Judge the large
    render for character and the small ones for legibility, then adopt one with the command on
    its card.
  </p>
{% endblock %}

{% block content %}
  <h2 class="section-title">Source Artwork</h2>
  <div class="panel mb-2.5 flex w-full max-w-325 flex-wrap items-center gap-6 border-2 border-accent-tertiary p-5.5">
    <img class="size-50 rounded-xl object-contain" src="{{ reference_hero }}" alt="Canonical reference">
    <div class="min-w-65 flex-1">
      <h3 class="m-0 mb-1.5 text-body text-palette-bright-magenta">{{ reference_name }}</h3>
      <p class="m-0 mb-3.5 text-caption leading-relaxed text-content-secondary">
        The original. Kept alongside for character reference, not as a target to converge on.
      </p>
      <div class="mb-4 flex flex-wrap items-end gap-3.5">
        {% for chip in reference_sizes %}
        <div class="flex flex-col items-center gap-1.5">
          <img class="rounded-lg border border-edge-subtle bg-surface-base" src="{{ chip.uri }}" alt="reference at {{ chip.size }}px">
          <span class="text-caption text-content-muted">{{ chip.size }}px</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <h2 class="section-title">Candidates</h2>
  <div class="flex w-full max-w-325 flex-col gap-4.5">
    {% for candidate in candidates %}
    <article class="panel relative flex flex-wrap items-start gap-6.5 p-5.5{% if candidate.is_current %} border-2 border-intent-success{% endif %}">
      {% if candidate.is_current %}
      <div class="ribbon left-5.5 bg-linear-to-r from-intent-success to-palette-teal text-content-inverse">&check; Current base</div>
      {% endif %}
      <img class="size-60 rounded-2xl object-contain" src="{{ candidate.hero }}" alt="{{ candidate.name }}">
      <div class="min-w-75 flex-1">
        <h3 class="m-0 mb-1.5 text-lead text-content-primary">{{ candidate.name }}</h3>
        <p class="m-0 mb-4 text-caption leading-relaxed text-content-secondary">{{ candidate.description }}</p>

        <div class="mb-4 flex flex-wrap items-end gap-3.5">
          {% for chip in candidate.sizes %}
          <div class="flex flex-col items-center gap-1.5">
            <img class="rounded-lg border border-edge-subtle bg-surface-base" src="{{ chip.uri }}" alt="{{ candidate.key }} at {{ chip.size }}px">
            <span class="text-caption text-content-muted">{{ chip.size }}px</span>
          </div>
          {% endfor %}
        </div>

        <dl class="m-0 mb-4 flex flex-wrap gap-x-2.5 gap-y-2">
          {% for row in candidate.spec %}
          <div class="flex gap-1.5 rounded-md border border-edge-subtle bg-surface-sunken px-2.5 py-0.5">
            <dt class="m-0 text-caption uppercase tracking-wide text-content-muted">{{ row.label }}</dt>
            <dd class="m-0 text-caption font-semibold text-content-secondary">{{ row.value }}</dd>
          </div>
          {% endfor %}
        </dl>

        <div class="flex flex-col gap-1.5 rounded-xl border border-dashed border-accent-primary bg-surface-sunken px-3.5 py-3">
          <span class="text-caption uppercase tracking-wide text-accent-primary">Adopt this base</span>
          <code class="break-all font-mono text-caption text-palette-bright-cyan">uv run image-reconcile build --variant {{ candidate.key }}</code>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>

  <h2 class="section-title">Socket Detail — Side by Side</h2>
  <div class="panel scroll-x p-4">
    <img class="block h-auto max-w-full pixelated" src="{{ socket_sheet }}" alt="Socket ring across all candidates">
  </div>
{% endblock %}
