name: Bug Report
description: Create a report to help us improve {{ repo_name }}
title: "bug: "
labels: ["type: bug"]
body:
  - type: markdown
    attributes:
      value: |
        Thanks for taking the time to fill out this bug report!
  - type: textarea
    id: description
    attributes:
      label: Bug Description
      description: A clear and concise description of what the bug is.
      placeholder: Tell us what you see vs what you expected to see.
    validations:
      required: true
  - type: textarea
    id: reproduction
    attributes:
      label: Steps To Reproduce
      description: Steps to reproduce the behavior.
      placeholder: |
        1. In this environment...
        2. With these inputs...
        3. Run command '...'
        4. See error
    validations:
      required: true
  - type: textarea
    id: minimal-sample
    attributes:
      label: Minimal Reproducible Code / Config
      description: Provide a minimal code snippet or configuration reproducing the issue.
      render: shell
  - type: dropdown
    id: os
    attributes:
      label: Operating System
      options:
        - macOS
        - Linux (Ubuntu / Debian)
        - Windows 11 / 10
        - Other
    validations:
      required: true
  - type: input
    id: runtime-version
    attributes:
      label: Runtime & Toolchain Versions
{% if "dotnet" in languages or primary_language == "dotnet" %}
      description: .NET SDK version, OS version, and {{ repo_name }} version (e.g. dotnet --version)
      placeholder: e.g. .NET 10.0.100
{% elif "python" in languages or primary_language == "python" %}
      description: Python version, toolchain, and OS version (e.g. python --version, uv --version)
      placeholder: e.g. Python 3.13, uv 0.6
{% elif "node" in languages or primary_language == "node" %}
      description: Node.js version, package manager, and OS version (e.g. node -v, pnpm -v)
      placeholder: e.g. Node 22, pnpm 10
{% else %}
      description: Toolchain and runtime versions (e.g., .NET 10 / Node 22 / Python 3.13)
      placeholder: Toolchain / runtime versions
{% endif %}
    validations:
      required: false
  - type: textarea
    id: logs
    attributes:
      label: Relevant Log Output
      description: Please copy and paste any relevant terminal output, stack traces, or logs.
      render: shell
