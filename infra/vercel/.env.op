# Secret *references*, not secrets — safe to commit. `op run --env-file=.env.op`
# resolves each op:// URI against 1Password and injects the result into the
# child process's environment, so no token is ever written to disk.
#
# Create the referenced item once with:
#
#   op item create --category="API Credential" --vault=Private \
#     --title=vercel-api-token credential="<token from vercel.com/account/tokens>"
#
# The title and vault here are what make the reference below resolve; change one,
# change the other.
VERCEL_API_TOKEN=op://Private/vercel-api-token/credential

# Not a secret, so it stays a literal. Only needed if the projects live under a
# Vercel team rather than the personal scope — leave commented until `pnpm
# discover` has confirmed which scope holds design-system-storybook.
# VERCEL_TEAM_ID=team_xxxxxxxx
