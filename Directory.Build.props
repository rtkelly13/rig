<Project>
  <!-- Every C# project in rig. ADR 0022 sets the bar: nullable on, warnings are errors, all analyzers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ICU, not invariant mode: the vault text rules need string.Normalize for non-ASCII (NFKD, NFKC). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The C# coverage ratchet (scripts/coverage-floor.cs): line and branch coverage together.
       The floor never falls, and must rise once coverage passes it by more than the slack. -->
  <PropertyGroup>
    <RigCoverageFloor>95</RigCoverageFloor>
    <RigCoverageTarget>95</RigCoverageTarget>
    <RigCoverageSlack>2</RigCoverageSlack>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Ryan Kelly</Authors>
    <Copyright>Copyright (c) 2026 Ryan Kelly</Copyright>
    <RepositoryUrl>https://github.com/rtkelly13/rig.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
