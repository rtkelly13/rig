<Project>
  <!-- Every C# project in rig. ADR 0022 sets the bar: nullable on, warnings are errors, all analyzers. The shared
       settings (and the banned APIs every repo shares) come from rtkelly-labs/foundations through Paket's Build group, so
       run `dotnet tool restore && dotnet paket restore` before the first build. Rig's own additions follow the import. -->
  <Import Project="$(MSBuildThisFileDirectory)paket-files/build/rtkelly-labs/foundations/dotnet/Common.props" />

  <!-- The C# coverage ratchet (coverage-floor.cs from foundations): line and branch coverage together.
       The floor never falls, and must rise once coverage passes it by more than the slack. -->
  <PropertyGroup>
    <CoverageFloor>95</CoverageFloor>
    <CoverageTarget>95</CoverageTarget>
    <CoverageSlack>2</CoverageSlack>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Ryan Kelly</Authors>
    <Copyright>Copyright (c) 2026 Ryan Kelly</Copyright>
    <RepositoryUrl>https://github.com/rtkelly13/rig.git</RepositoryUrl>
  </PropertyGroup>
</Project>
