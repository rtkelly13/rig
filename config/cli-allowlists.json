    "denied": [
      {"pattern": "git reset --hard*", "rationale": "Discards tracked changes."},
      {"pattern": "git clean -fd*", "rationale": "Deletes untracked files."},
      {"pattern": "git branch -D*", "rationale": "Force-deleting branches requires explicit confirmation."},
      {"pattern": "gh stack sync *--prune*", "rationale": "Deletes local branches; estate tidy owns branch removal, as with git branch -D."},
      {"pattern": "rm -rf *", "rationale": "Broad deletion requires an explicit, reviewed exception."},
      {"pattern": "gh auth refresh*", "rationale": "Token scopes change through the declared scope policy (devenv doctor git auth), never ad hoc."},
      {"pattern": "gh auth logout*", "rationale": "Logging out breaks every gh-backed tool on the machine."},
      {"pattern": "gh auth token*", "rationale": "Prints the OAuth token into the transcript."},
