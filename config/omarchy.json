{
  "idle": {
    "screensaver_seconds": 1800,
    "lock_seconds": 3600
  },
  "suspend": {
    "menu": true,
    "lid": "ignore",
    "power_key": "ignore",
    "suspend_key": "ignore",
    "hibernate_key": "ignore",
    "idle_action": "ignore"
  },
  "lock_before_suspend": true,
  "theme": "tokyo-night",
  "power": {
    "ac": "performance",
    "battery": "power-saver"
  },
  "font": {
    "base_size": 13
  },
  "shell": {
    "bar": {
      "position": "top",
      "background": "opaque",
      "layout": {
        "left": [
          {
            "id": "omarchy.menu"
          },
          {
            "id": "omarchy.workspaces"
          }
        ],
        "centerBegin": [
          {
            "id": "omarchy.indicators"
          }
        ],
        "center": [
          {
            "id": "omarchy.clock",
            "format": "dddd HH:mm",
            "formatAlt": "d MMMM 'W'ww yyyy",
            "verticalFormat": "HH\n—\nmm"
          }
        ],
        "centerEnd": [
          {
            "id": "omarchy.elsewhen",
            "cities": [
              {
                "name": "London",
                "zone": "Europe/London"
              },
              {
                "name": "Dubai",
                "zone": "Asia/Dubai"
              },
              {
                "name": "Tokyo",
                "zone": "Asia/Tokyo"
              },
              {
                "name": "Los Angeles",
                "zone": "America/Los_Angeles"
              },
              {
                "name": "New York",
                "zone": "America/New_York"
              }
            ]
          },
          {
            "id": "omarchy.weather"
          },
          {
            "id": "omarchy.system-update"
          }
        ],
        "right": [
          {
            "id": "omarchy.tray"
          },
          {
            "id": "omarchy.keyboard-layout"
          },
          {
            "id": "omarchy.agents"
          },
          {
            "id": "omarchy.bluetooth"
          },
          {
            "id": "omarchy.network"
          },
          {
            "id": "omarchy.audio"
          },
          {
            "id": "omarchy.monitor"
          },
          {
            "id": "omarchy.power"
          },
          {
            "id": "cheatsheet",
            "type": "qml"
          }
        ],
        "tray": [
          {
            "id": "superwhisper.panel"
          }
        ]
      }
    },
    "dock": {
      "position": "bottom",
      "pinned": [
        "org.gnome.Nautilus",
        "chromium",
        "foot",
        "omacalc",
        "omawrite",
        "X",
        "YouTube"
      ]
    },
    "plugins": []
  }
}
