{
  "schema_version": 2,
  "automations": [
    {
      "key": "daily-estate",
      "name": "Daily estate review",
      "roles": [
        "personal",
        "work"
      ],
      "management": "manage",
      "orca": {
        "instance": "personal"
      },
      "trigger": {
        "timezone": "Europe/London",
        "rrule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=9;BYMINUTE=30",
        "missed_run_grace_minutes": 720
      },
      "provider": {
        "agent": "claude",
        "reuse_session": false
      },
      "workspace": {
        "mode": "existing",
        "path": "{personal}/rig"
      },
      "bootstrap": "docs/daily-orchestrator/bootstrap.md",
      "policy_path": "docs/daily-orchestrator/policy.md",
      "memory_issue": null
    },
