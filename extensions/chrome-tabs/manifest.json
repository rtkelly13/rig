{
  "manifest_version": 3,
  "name": "rig chrome-tabs",
  "version": "0.1.0",
  "description": "Lets `rig chrome-tabs` read, close, group and move this profile's tabs. Installed by rig; all decisions are made by rig.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "identity", "identity.email", "alarms"],
  "background": { "service_worker": "background.js" }
}
